# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.busted = busted config: src on lpath, *_spec files under tests/
	.mechatron-prime/targets = Mechatron Prime CI flake attributes to build per push
	README.md = Public overview, CI badge, run instructions
	RULES.md = Always-on project rules: functional style, LLMs propose/engine decides, oracles, child data, automation
	content/evidence_policy.lua = pedagogy-priors/2 as evidence-policy/1 entries (tier, use, review section, DOIs)
	content/kpk_curriculum.lua = King-and-pawn skill graph; ids match the skills items score
	content/kpk_week.lua = Authored one-week king-and-pawn course: square, opposition, key squares, day-7 check with rook-pawn transfer
	docs/ARCHITECTURE.md = v0 architecture, measured environment/sandbox constraints, versioned contract list, first-slice acceptance
	docs/PLAN_LOG.md = Append-only log of retired PLAN.md items
	docs/evidence/EARLY_LITERACY_NUMERACY_2026-09-28.md = Evidence review for a 5-year-old pre-reader: phonics, phonemic awareness, apps, early numeracy, child ASR accuracy
	docs/evidence/ERRONEOUS_EXAMPLES_2026-09-30.md = Evidence review: erroneous examples, false feedback, AI error detection, variable reinforcement, deception
	docs/evidence/EVIDENCE_2026-09-28.md = Primary-source evidence review (evidence-policy/1): tiers, populations, moderators, citations, unverified list
	docs/evidence/GAMES_AND_TYPING_2026-09-28.md = Evidence review: gamification, game-based learning, intrinsic integration, drill games, rewards, typing
	docs/evidence/SPACED_REVIEW_2026-09-30.md = Evidence review: spacing gaps, expanding vs uniform, successive relearning, fitted schedulers, target retention, varied instances, misinformation correction and inoculation
	docs/evidence_adaptive_ai_education_meta_prompt.md = Verified, unmodified founding requirements, byte-for-byte as received
	docs/plan_context/checkpoints.md = Checkpoint rules: anchor, offsets, skipping, separation from practice
	docs/plan_context/counterfeit_scrutiny.md = Design: disclosed variable-rate planted errors, Prove-it vs error claims, scrutiny axis
	docs/plan_context/handwriting_capture.md = Design notes: finger-written letter capture on iOS web page, $P recognizer scoring, parent-as-oracle control
	docs/plan_context/history_images.md = Design notes: image provenance labels, open archives, AI-image accuracy and labeling rules
	docs/plan_context/spoken_audio.md = Design notes: pre-rendered, approved TTS clips for pre-readers; phoneme-audio risk; engine options
	docs/plan_context/timed_items.md = Design notes: optional item timing, timeout outcomes, fluency vs accuracy
	docs/policy/DIVERGENCES.md = Record of design choices that depart from tradition or evidence, each with justification and measurement
	docs/policy/ORACLES.md = Oracle preference order (tool > algorithm > vetted AI simulation > human-reviewed), approval workflow
	docs/policy/PEDAGOGY_PRIORS.md = pedagogy-priors/2: versioned priors superseding founding prompt 2.3; 4-6 month review cadence, next due 2027-02-28
	serve = Starts the web app inside the flake env (--help, --about, --host, --port, --data, --learner)
	src/ai_edu/canonical.lua = Canonical JSON encoder (sorted keys, safe ints) used for byte-identical replay comparison and NDJSON storage
	src/ai_edu/checkpoints.lua = Which skills owe a 1/7/30-day unaided no-feedback checkpoint, folded from the log
	src/ai_edu/course.lua = Course as pure functions of (definition, events, now): status, start, resume; day unlocks and reviews
	src/ai_edu/curriculum.lua = curriculum-node/1: validate prerequisite DAG (shape, dangling ids, cycles), topological order
	src/ai_edu/event.lua = event/1 contract validator; actor/type matrix restricts LLM roles to proposal events
	src/ai_edu/event_log.lua = Append-only in-memory event log: validate, copy in/out, dense seq, canonical NDJSON encode/decode
	src/ai_edu/evidence_policy.lua = evidence-policy/1: validate the priors-as-data and check lessons cite known, permitted techniques
	src/ai_edu/http_app.lua = Imperative shell: owns log, clock and session state; routes call pure transitions and append their events
	src/ai_edu/item.lua = item/1 question contract: validate, key-free public_view allowlist, deterministic choice/typed scoring
	src/ai_edu/kpk.lua = KPK endgame solver: FFI retrograde analysis, win/draw per position and per move; oracle for chess items
	src/ai_edu/kpk_content.lua = Builds KPK lessons from authored cards; solver derives every key and rejects contradicted claims
	src/ai_edu/kpk_gen.lua = Seeded generator of fresh KPK positions per concept (square, opposition, key squares, pawn push), solver-verified and kept distinct
	src/ai_edu/kpk_review.lua = KPK review provider: scheduler-due skills -> interleaved fresh never-seen positions; plans logged for resume
	src/ai_edu/learner_projection.lua = learner-projection/1: replay/step fold of engine-scored answers; independent vs assisted counts
	src/ai_edu/log_file.lua = File-backed event log: replay+validate NDJSON on open, flushed append per accepted event
	src/ai_edu/main.lua = Server entrypoint: real clock/day adapters, file log, solver-built course, static client, lua-http
	src/ai_edu/mastery.lua = mastery-estimate/1: BKT (bkt@1) per-skill estimate folded from the log; independent-only; sensitivity interval
	src/ai_edu/rng.lua = Seeded Park-Miller PRNG shared by simulation and content generation
	src/ai_edu/sandbox.lua = Run untrusted activity code in a child LuaJIT under unshare/prlimit/timeout; JSON outcome
	src/ai_edu/sandbox_child.lua = Sandbox child: stripped env, JIT off, instruction and heap hook, source-only load
	src/ai_edu/scheduler.lua = Spaced-review scheduler: pure fold over the log, successive-relearning criterion, swappable interval model (ladder@1 default), due list
	src/ai_edu/session.lua = Session engine as pure transitions (init/present/next/submit/report/restore/progress) returning new state + events
	src/ai_edu/sim_client.lua = Browser-free driver: runs a session through POST /api/next and /api/submit with a simulated learner
	src/ai_edu/sim_learner.lua = Simulated learner: seeded per-skill knowledge model answering public item views (no browser needed)
	src/ai_edu/web_server.lua = lua-http adapter: socket <-> pure handler translation, query stripping, request body size limit (413)
	test = Single verification path: builds the sandboxed flake check (runs tests/run); refuses untracked source/test files
	tests/cli/chain_log_cli = CLI tests for tools/chain-log
	tests/cli/serve_cli = CLI surface tests for ./serve
	tests/fixtures/kpk_lichess.lua = 300 lichess tablebase results: independent oracle for the KPK solver
	tests/integration/kpk_course_sim_spec.lua = Browser-free run of the real KPK lesson through the HTTP stack with a simulated learner
	tests/integration/simulated_session_spec.lua = E2E: simulated learner over real socket; server log replays to what it did
	tests/integration/web_server_spec.lua = Real-socket round trip and 413 limit for the lua-http adapter
	tests/run = Inner suite runner (busted + CLI tests) executed by the Nix check; also for fast TDD loops
	tests/support/fixtures.lua = Test builders: event/1 fixtures, Park-Miller seeded RNG, random valid event sequences
	tests/unit/rng_spec.lua = ai_edu.rng draws from random's BLAKE3 DRBG: reference equality, reproducibility, secret seeds
	tools/chain-log = One-time migration of a pre-chain event log to hash-chained lines; keeps <path>.pre-chain
	tools/fetch-kpk-fixtures = Fetches seeded KPK positions from the lichess Syzygy API into tests/fixtures/kpk_lichess.lua
	web/app.js = Thin fixed client: lesson list, board rendering, choice/move/info/typed answers, feedback, report dialog
	web/index.html = Client shell page
	web/style.css = Client styles (light/dark, board)
]
